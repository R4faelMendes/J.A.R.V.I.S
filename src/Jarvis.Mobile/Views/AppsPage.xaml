<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jarvis.Mobile.Views.AppsPage" Title="Apps" Shell.NavBarIsVisible="False">
  <Grid Padding="20,16,20,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <Label Text="Aplicativos" Style="{StaticResource Titulo}" VerticalOptions="Center"/>
      <Button Grid.Column="1" Text="Escolher apps" Clicked="EscolherApps"/>
    </Grid>
    <SearchBar Grid.Row="1" Placeholder="Buscar no computador" TextChanged="Filtrar"/>
    <Label Grid.Row="2" x:Name="Estado" Text="Conecte ao PC para carregar os aplicativos."/>
    <CollectionView Grid.Row="3" x:Name="Lista" SelectionMode="None">
      <CollectionView.EmptyView><Label Text="Nenhum aplicativo para mostrar." Margin="0,20"/></CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Painel}">
            <VerticalStackLayout Spacing="12">
              <Label Text="{Binding Nome}" FontFamily="ChakraPetchSemiBold" FontSize="20"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Abrir" Style="{StaticResource Primario}" Clicked="Abrir"/>
                <Button Grid.Column="1" Text="Fechar" Clicked="Fechar"/>
              </Grid>
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
