<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Jarvis.Mobile.Views"
             x:Class="Jarvis.Mobile.Views.FalarPage" Title="Falar">
  <ScrollView><VerticalStackLayout Padding="20,16,20,28" Spacing="12" MaximumWidthRequest="640">
    <Label Text="Controle por voz" Style="{StaticResource Titulo}"/>
    <views:ReactorArt x:Name="Reator" HeightRequest="260" HorizontalOptions="Fill"/>
    <Label x:Name="Transcricao" Text="Toque em Falar com Jarvis para usar o microfone." HorizontalTextAlignment="Center"/>
    <Button x:Name="BotaoFalar" Text="Falar com Jarvis" Style="{StaticResource Primario}" MinimumHeightRequest="64" Clicked="Falar"/>
    <Label Text="Com o PC conectado, diga comandos como “abrir Chrome”, “próxima música” ou “volume cinquenta”." Style="{StaticResource Cabecalho}" HorizontalTextAlignment="Center"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
