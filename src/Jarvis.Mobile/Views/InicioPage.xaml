<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Jarvis.Mobile.Views"
             x:Class="Jarvis.Mobile.Views.InicioPage" Title="Início" Shell.NavBarIsVisible="False">
  <ScrollView>
    <VerticalStackLayout Padding="20,18,20,28" Spacing="16" MaximumWidthRequest="760">
      <Label Text="JARVIS" Style="{StaticResource Titulo}" CharacterSpacing="4"/>
      <Border Style="{StaticResource Painel}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <VerticalStackLayout Spacing="3">
            <Label x:Name="PcLinha" FontFamily="ChakraPetchSemiBold" FontSize="20" Text="Nenhum PC selecionado"/>
            <Label x:Name="Status" Text="Aguardando conexão"/>
          </VerticalStackLayout>
          <Button Grid.Column="1" Text="Trocar PC" Clicked="MeusPcs"/>
        </Grid>
      </Border>
      <views:ReactorArt x:Name="Reator" HeightRequest="250" HorizontalOptions="Fill" Margin="0,-12,0,-12"/>
      <Button Text="Falar com Jarvis" Style="{StaticResource Primario}" Clicked="Falar"/>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
        <Button Text="Aplicativos" Clicked="Apps"/>
        <Button Grid.Column="1" Text="Janelas" Clicked="Controles"/>
        <Button Grid.Row="1" Text="Desempenho" Clicked="Desempenho"/>
        <Button Grid.Row="1" Grid.Column="1" Text="Agenda" Clicked="Agenda"/>
        <Button Grid.Row="2" Text="Tela ao vivo" Clicked="TelaAoVivo"/>
        <Button Grid.Row="2" Grid.Column="1" Text="Acordar PC" Clicked="LigarPc"/>
      </Grid>
      <views:MidiaCard x:Name="Player"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
