<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:views="clr-namespace:Jarvis.Mobile.Views" x:Class="Jarvis.Mobile.Views.InicioPage" Title="Início" Shell.NavBarIsVisible="False">
 <ScrollView><VerticalStackLayout Padding="20,16,20,24" Spacing="17">
  <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="12" Padding="0,0,0,14"><Border Stroke="#00D800" StrokeShape="RoundRectangle 5" HeightRequest="29" WidthRequest="29" Padding="0"><Label Text="◇" FontSize="26" TextColor="#00D800" HorizontalOptions="Center" VerticalOptions="Center"/></Border><Label Grid.Column="1" Text="J A R V I S" FontSize="21" FontFamily="ChakraPetchSemiBold" VerticalOptions="Center"/><Button Grid.Column="2" Text="⚙" FontSize="20" WidthRequest="36" HeightRequest="36" MinimumHeightRequest="36" Padding="0" BackgroundColor="Transparent" BorderWidth="0" Clicked="Mais"/></Grid>
  <BoxView HeightRequest="1" Color="#333333" Margin="-20,-10,-20,0"/>
  <Grid ColumnDefinitions="*,Auto"><Label Text="NÚCLEO / MARK IV" FontSize="10" CharacterSpacing="2" TextColor="#BBBBBB"/><Label Grid.Column="1" x:Name="Status" Text="Aguardando conexão" FontSize="10" TextColor="#F4B544"/></Grid>
  <views:ReactorArt x:Name="Reator" HeightRequest="285" HorizontalOptions="Fill" Margin="0,-6,0,-4"/>
  <VerticalStackLayout Spacing="9" HorizontalOptions="Fill"><Label Text="Sempre às suas ordens." HorizontalTextAlignment="Center" FontSize="23"/><Label x:Name="PcLinha" Text="Conecte seu computador para começar" HorizontalTextAlignment="Center" FontSize="12" TextColor="#BBBBBB"/><Button Text="◉   Falar com Jarvis" HorizontalOptions="Center" Padding="25,10" Margin="0,6,0,0" Clicked="Falar"/></VerticalStackLayout>
  <Border Style="{StaticResource Painel}" Margin="0" Padding="16"><VerticalStackLayout Spacing="10"><Grid ColumnDefinitions="*,Auto"><Label Text="COMPUTADOR / CONTROLE REMOTO" FontSize="10" CharacterSpacing="1" TextColor="#BBBBBB"/><Image Grid.Column="1" Source="windows_icon.png" WidthRequest="17" HeightRequest="17"/></Grid><Button Text="Ligar computador" Style="{StaticResource Primario}" FontSize="14" Clicked="LigarPc"/><Label Text="Wake-on-LAN · usa a configuração do PC pareado" FontSize="10" TextColor="#BBBBBB"/></VerticalStackLayout></Border>
  <Label Text="ACESSO RÁPIDO" FontSize="10" CharacterSpacing="2" TextColor="#BBBBBB"/>
  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
   <Border Style="{StaticResource Painel}" Margin="0" MinimumHeightRequest="105"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Apps"/></Border.GestureRecognizers><VerticalStackLayout Spacing="8"><Image Source="apps_icon.png" HeightRequest="22" HorizontalOptions="Start"/><Label Text="Aplicativos" FontSize="14"/><Label Text="Abrir e controlar" FontSize="10" TextColor="#BBBBBB"/></VerticalStackLayout></Border>
   <Border Grid.Column="1" Style="{StaticResource Painel}" Margin="0" MinimumHeightRequest="105"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Controles"/></Border.GestureRecognizers><VerticalStackLayout Spacing="8"><Image Source="windows_icon.png" HeightRequest="22" HorizontalOptions="Start"/><Label Text="Janelas e grades" FontSize="14"/><Label Text="Organize seu desktop" FontSize="10" TextColor="#BBBBBB"/></VerticalStackLayout></Border>
   <Border Grid.Row="1" Style="{StaticResource Painel}" Margin="0" MinimumHeightRequest="105"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Midia"/></Border.GestureRecognizers><VerticalStackLayout Spacing="8"><Label Text="♫" TextColor="#00D800" FontSize="23"/><Label Text="Mídia e volume" FontSize="14"/><Label Text="Seu som, sob controle" FontSize="10" TextColor="#BBBBBB"/></VerticalStackLayout></Border>
   <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Painel}" Margin="0" MinimumHeightRequest="105"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Desempenho"/></Border.GestureRecognizers><VerticalStackLayout Spacing="8"><Image Source="gauge_icon.png" HeightRequest="22" HorizontalOptions="Start"/><Label Text="Desempenho" FontSize="14"/><Label Text="Métricas em tempo real" FontSize="10" TextColor="#BBBBBB"/></VerticalStackLayout></Border>
  </Grid>
  <Border Style="{StaticResource Painel}" Margin="0"><Border.GestureRecognizers><TapGestureRecognizer Tapped="TelaAoVivo"/></Border.GestureRecognizers><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="5"><Label Text="Suas telas, ao vivo" FontSize="16"/><Label Text="Escolha um monitor e controle por toque" FontSize="11" TextColor="#BBBBBB"/></VerticalStackLayout><Label Grid.Column="1" Text="↗" FontSize="23" VerticalOptions="Center" TextColor="#00D800"/></Grid></Border>
  <views:MidiaCard x:Name="Player"/>
  <Button Text="Parear ou trocar computador  ↗" BackgroundColor="Transparent" TextColor="#00D800" Clicked="Parear"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
