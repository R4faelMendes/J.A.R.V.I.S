<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jarvis.Mobile.Views.ParearPage" Title="Adicionar PC">
  <ScrollView>
    <VerticalStackLayout Padding="20,16,20,28" Spacing="12" MaximumWidthRequest="640">
      <Label Text="Parear computador" Style="{StaticResource Titulo}"/>
      <Label Text="Abra Dispositivos no PC. Conecte o celular ao mesmo roteador e escolha QR ou PIN."/>
      <Border Style="{StaticResource Painel}">
        <VerticalStackLayout Spacing="8">
          <Label Text="Conectar por QR" FontFamily="ChakraPetchSemiBold" FontSize="20"/>
          <Button Text="Escanear com a câmera" Style="{StaticResource Primario}" Clicked="Escanear"/>
        </VerticalStackLayout>
      </Border>
      <Border Style="{StaticResource Painel}">
        <VerticalStackLayout Spacing="10">
          <Label Text="Conectar por PIN" FontFamily="ChakraPetchSemiBold" FontSize="20"/>
          <Label x:Name="BuscaStatus" Text="Procurando computadores no Wi-Fi…" Style="{StaticResource Cabecalho}"/>
          <Picker x:Name="Computadores" Title="Selecione seu computador" IsVisible="False" SelectedIndexChanged="SelecionarPc"/>
          <Button x:Name="Buscar" Text="Buscar no Wi-Fi" Clicked="Descobrir"/>
          <Entry x:Name="Ip" Placeholder="Endereço IP do computador"/>
          <Entry x:Name="Codigo" Placeholder="PIN" Keyboard="Numeric" MaxLength="6"/>
          <Button Text="Confirmar pareamento" Clicked="ParearCodigo"/>
        </VerticalStackLayout>
      </Border>
      <Label x:Name="Msg"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
