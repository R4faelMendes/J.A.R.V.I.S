<?xml version="1.0" encoding="UTF-8" ?>
<!--
  JARVIS Mobile — tokens (mesmos do desktop, seção 4). Sentence case, toque mínimo 44px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <Color x:Key="Abismo">#030D16</Color>
  <Color x:Key="Vidro">#081B29</Color>
  <Color x:Key="Linha">#1B3A57</Color>
  <Color x:Key="CianoHolo">#4FD6FF</Color>
  <Color x:Key="Gelo">#EDF5F5</Color>
  <Color x:Key="Nevoa">#A5BBC7</Color>
  <Color x:Key="Ouro">#F4B544</Color>
  <Color x:Key="Vermelho">#FF4D3D</Color>
  <Color x:Key="Verde">#4DE3A1</Color>

  <Style TargetType="Page" ApplyToDerivedTypes="True">
    <Setter Property="BackgroundColor" Value="{StaticResource Abismo}"/>
  </Style>
  <Style TargetType="Label" ApplyToDerivedTypes="True">
    <Setter Property="TextColor" Value="{StaticResource Gelo}"/>
    <Setter Property="FontFamily" Value="IBMPlexSansRegular"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style x:Key="Titulo" TargetType="Label">
    <Setter Property="FontFamily" Value="ChakraPetchSemiBold"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="TextColor" Value="{StaticResource Gelo}"/>
  </Style>
  <Style x:Key="Cabecalho" TargetType="Label">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextColor" Value="{StaticResource Nevoa}"/>
  </Style>
  <Style x:Key="Painel" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{StaticResource Vidro}"/>
    <Setter Property="Stroke" Value="{StaticResource Linha}"/>
    <Setter Property="StrokeThickness" Value="1"/>
    <Setter Property="StrokeShape" Value="RoundRectangle 5"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="Primario" TargetType="Button">
    <Setter Property="BackgroundColor" Value="{StaticResource CianoHolo}"/>
    <Setter Property="TextColor" Value="#050D18"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="MinimumHeightRequest" Value="44"/>
    <Setter Property="FontFamily" Value="IBMPlexSansMedium"/>
  </Style>
  <Style TargetType="Button"><Setter Property="BackgroundColor" Value="#0B2434"/><Setter Property="TextColor" Value="#EDF5F5"/><Setter Property="CornerRadius" Value="4"/><Setter Property="BorderWidth" Value="1"/><Setter Property="BorderColor" Value="#3B5263"/><Setter Property="MinimumHeightRequest" Value="48"/><Setter Property="FontFamily" Value="IBMPlexSansMedium"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="Entry"><Setter Property="BackgroundColor" Value="#0B202F"/><Setter Property="TextColor" Value="#EDF5F5"/><Setter Property="PlaceholderColor" Value="#7892A5"/><Setter Property="MinimumHeightRequest" Value="48"/><Setter Property="FontFamily" Value="IBMPlexSansRegular"/></Style>
  <Style TargetType="SearchBar"><Setter Property="BackgroundColor" Value="#0B202F"/><Setter Property="TextColor" Value="#EDF5F5"/><Setter Property="PlaceholderColor" Value="#7892A5"/></Style>
  <Style TargetType="Slider">
    <Setter Property="MinimumTrackColor" Value="{StaticResource CianoHolo}"/>
    <Setter Property="MaximumTrackColor" Value="{StaticResource Linha}"/>
    <Setter Property="ThumbColor" Value="{StaticResource CianoHolo}"/>
    <Setter Property="MinimumHeightRequest" Value="44"/>
    <Setter Property="Margin" Value="2,6"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Color" Value="{StaticResource CianoHolo}"/>
    <Setter Property="MinimumHeightRequest" Value="44"/>
    <Setter Property="MinimumWidthRequest" Value="44"/>
  </Style>
</ResourceDictionary>
