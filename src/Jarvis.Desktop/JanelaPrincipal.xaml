<Window x:Class="Jarvis.Desktop.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:Jarvis.Desktop.Controles"
        Title="JARVIS" Height="900" Width="1440"
        Background="{StaticResource Fundo}" Foreground="{StaticResource Texto}"
        FontFamily="{StaticResource FonteTexto}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="88"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navegação lateral estreita: só ícones, expande com rótulos ao passar o mouse -->
    <Border Grid.Column="0" Background="#0A1420" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
      <StackPanel x:Name="Navegacao" Margin="0,16,0,16">
        <Button Click="IrNucleo" ToolTip="Núcleo" Content="◉" FontSize="22"
                Foreground="{StaticResource Acento}" Background="Transparent" BorderThickness="0" Margin="0,0,0,16"/>
        <ItemsControl x:Name="ItensNavegacao"/>
        <StackPanel VerticalAlignment="Bottom"/>
      </StackPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Barra superior: avatar, atalho Ctrl+Espaço, status de conexão -->
      <Grid Row="0" Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#140F2E"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="LM" Foreground="{StaticResource Acento}" FontSize="13"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                   Foreground="{StaticResource Texto2}" FontSize="12">
          Ctrl + Espaço para falar
        </TextBlock>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="#4DE3A1" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusConexao" Text="Online" FontSize="12" Foreground="{StaticResource Texto2}"/>
        </StackPanel>
      </Grid>

      <!-- Área central: as telas entram aqui -->
      <ContentControl x:Name="Conteudo" Grid.Row="1" Margin="24,8,24,8"/>

      <!-- Dock do reator: pequeno, fixo, reflete o estado em tempo real -->
      <Border Grid.Row="2" Margin="24,0,24,16" Style="{StaticResource PainelVidro}"
              Padding="12,8" CornerRadius="20" Cursor="Hand" MouseLeftButtonUp="AlternarEscuta">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <controles:VisaoReator x:Name="ReatorDock" Width="56" Height="56"/>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="RotuloEstado" Text="Em repouso" FontSize="14"/>
            <TextBlock Text="Diga “Jarvis” ou clique" FontSize="12" Foreground="{StaticResource Texto2}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
