<Window x:Class="Jarvis.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Jarvis.Desktop.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Jarvis — Central de comando" Width="1440" Height="940" MinWidth="1050" MinHeight="720" Icon="Assets/jarvis.ico" WindowStyle="None" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="98" ResizeBorderThickness="6" CornerRadius="5" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{DynamicResource BordaLinha}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource FundoAbismo}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="58"/><RowDefinition Height="78"/><RowDefinition Height="25"/></Grid.RowDefinitions>
 <Border Background="{DynamicResource PainelVidroEscuroFundo}" BorderBrush="{DynamicResource BordaLinha}" BorderThickness="0,0,0,1">
  <DockPanel Margin="18,0,0,0"><StackPanel DockPanel.Dock="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal"><Button Content="−" Width="45" Height="31" Padding="0" Background="Transparent" BorderThickness="0" Click="Minimizar_Click" ToolTip="Minimizar"/><Button Content="□" Width="45" Height="31" Padding="0" Background="Transparent" BorderThickness="0" Click="Maximizar_Click" ToolTip="Maximizar"/><Button Content="×" Width="45" Height="31" Padding="0" Background="Transparent" BorderThickness="0" Click="Fechar_Click" ToolTip="Continuar na bandeja"/></StackPanel><TextBlock Text="JARVIS  /  MARK IV  ·  CENTRAL DE COMANDO" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextoNevoa}" VerticalAlignment="Center"/></DockPanel>
 </Border>
 <Border Grid.Row="1" BorderBrush="{DynamicResource BordaLinha}" BorderThickness="0,0,0,1"><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="30" Height="30" CornerRadius="15" BorderBrush="{DynamicResource AcaoCiano}" BorderThickness="1" Margin="0,0,13,0"><TextBlock Text="◇" Foreground="{DynamicResource AcaoCiano}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/></Border><TextBlock Text="J A R V I S" Foreground="{DynamicResource TextoGelo}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
 <Border Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="{DynamicResource PainelVidroEscuroFundo}" BorderBrush="{DynamicResource BordaLinha}" BorderThickness="1" CornerRadius="4" Height="36" Margin="20,0,35,0" MaxWidth="480">
 <Button Content="◉   Ativar microfone" Click="AtivarMicrofone_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" ToolTip="Diga Jarvis ou pressione Ctrl+Espaço"/></Border>
 <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="31" Height="31" Background="{DynamicResource PainelVidroEscuroFundo}" BorderBrush="{DynamicResource BordaLinha}" BorderThickness="1" CornerRadius="16"><TextBlock x:Name="TxtIniciaisTop" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AcaoCiano}" FontFamily="Consolas" FontSize="10"/></Border><TextBlock x:Name="TxtNomeTop" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextoGelo}" FontSize="12"/></StackPanel>
 </Grid></Border>
 <ContentControl Grid.Row="2" x:Name="AreaConteudo"/>
 <Border Grid.Row="3" x:Name="BarraVoz" BorderBrush="{DynamicResource BordaLinha}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource PainelVidroEscuroFundo}" MaxWidth="760" HorizontalAlignment="Stretch" Margin="25,3,25,8" Padding="12,3">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><views:VoiceWaveView Nivel="{Binding NivelAudio}" Height="28" Width="70"/>
 <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0"><TextBlock x:Name="RotuloEstado" Text="Diga Jarvis. Estou ouvindo." Foreground="{DynamicResource TextoGelo}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UltimaTranscricao}" Foreground="{DynamicResource AcaoCiano}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Content="Parar" Click="Interromper_Click" Background="Transparent" BorderThickness="0" Padding="10,4"/><Button Grid.Column="3" Content="◉" Command="{Binding AtivarEscutaCommand}" ToolTip="Escuta manual alternativa" Width="32" Height="32" Padding="0" FontSize="19" Foreground="{DynamicResource AcaoCiano}" Background="Transparent"/>
 </Grid></Border>
 <Border Grid.Row="4" BorderBrush="{DynamicResource BordaLinha}" BorderThickness="0,1,0,0" Background="{DynamicResource PainelVidroEscuroFundo}"><views:SidebarControl x:Name="BarraLateral"/></Border>
 <Border Grid.Row="5" BorderBrush="{DynamicResource BordaLinha}" BorderThickness="0,1,0,0"><Grid Margin="20,0"><TextBlock Text="MARK IV  /  ASSISTENTE LOCAL" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource TextoNevoa}" VerticalAlignment="Center"/><Border x:Name="ChipStatusConexao" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DotStatus" Width="5" Height="5" Margin="0,0,7,0"/><TextBlock x:Name="TxtStatusCelular" FontSize="10" VerticalAlignment="Center"/></StackPanel></Border></Grid></Border>
 <views:ReactorView x:Name="DockReator" Visibility="Collapsed" Width="1" Height="1" Estado="{Binding EstadoReator}" NivelAudio="{Binding NivelAudio}" UsarSkia="{Binding SkiaAtivo}"/>
 <Border x:Name="ToastContainer" Grid.RowSpan="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,112,24,0" Background="{DynamicResource PainelVidroEscuroFundo}" BorderBrush="{DynamicResource AcaoCiano}" BorderThickness="1" CornerRadius="5" Padding="16,12" Visibility="Collapsed" Panel.ZIndex="999" MaxWidth="480"><TextBlock x:Name="ToastTexto" Foreground="{DynamicResource TextoGelo}" TextWrapping="Wrap"/></Border>
 </Grid></Border>
</Window>
