<Application x:Class="Jarvis.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Cores Principais -->
      <Color x:Key="Abismo">#030D16</Color>
      <Color x:Key="Vidro">#081B29</Color>
      <Color x:Key="VidroEscuro">#081422</Color>
      <Color x:Key="Linha">#1B3A57</Color>
      <Color x:Key="CianoHolo">#4FD6FF</Color>
      <Color x:Key="Gelo">#EDF5F5</Color>
      <Color x:Key="Nevoa">#A5BBC7</Color>
      <Color x:Key="Ouro">#F4B544</Color>
      <Color x:Key="VermelhoNucleo">#FF4D3D</Color>
      <Color x:Key="VerdeSistema">#35F29A</Color>

      <!-- Brushes -->
      <SolidColorBrush x:Key="FundoAbismo" Color="{StaticResource Abismo}"/>
      <LinearGradientBrush x:Key="PainelVidroFundo" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#102235" Offset="0"/><GradientStop Color="#08121E" Offset="1"/></LinearGradientBrush>
      <SolidColorBrush x:Key="PainelVidroEscuroFundo" Color="{StaticResource VidroEscuro}"/>
      <SolidColorBrush x:Key="BordaLinha" Color="{StaticResource Linha}"/>
      <SolidColorBrush x:Key="TextoGelo" Color="{StaticResource Gelo}"/>
      <SolidColorBrush x:Key="TextoNevoa" Color="{StaticResource Nevoa}"/>
      <SolidColorBrush x:Key="AcaoCiano" Color="{StaticResource CianoHolo}"/>
      <SolidColorBrush x:Key="CorOuro" Color="{StaticResource Ouro}"/>
      <SolidColorBrush x:Key="CorVermelho" Color="{StaticResource VermelhoNucleo}"/>
      <SolidColorBrush x:Key="CorVerde" Color="{StaticResource VerdeSistema}"/>

      <!-- Fontes -->
      <FontFamily x:Key="FonteTitulo">./Assets/Fonts/#Chakra Petch</FontFamily>
      <FontFamily x:Key="FonteTexto">./Assets/Fonts/#IBM Plex Sans</FontFamily>

      <!-- Window Padrão -->
      <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource FundoAbismo}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="14"/>
      </Style>

      <Style TargetType="UserControl"><Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/></Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/><Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="21" Height="21" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource BordaLinha}" Background="{DynamicResource PainelVidroEscuroFundo}" VerticalAlignment="Center">
              <TextBlock x:Name="Tick" Text="✓" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource FundoAbismo}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="9,5,0,5" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource AcaoCiano}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AcaoCiano}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Tick" Property="Text" Value="−"/><Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource AcaoCiano}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AcaoCiano}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2.5"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AcaoCiano}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/></Style>
      <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/></Style>
      <!-- Botão Padrão (Sempre Arredondado) -->
      <Style TargetType="Button">
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.83"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AcaoCiano}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource PainelVidroEscuroFundo}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordaLinha}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Títulos e Cabeçalhos -->
      <Style x:Key="TituloPagina" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/>
      </Style>

      <Style x:Key="CabecalhoPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoNevoa}"/>
      </Style>

      <!-- Painel Vidro -->
      <Style x:Key="PainelVidro" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PainelVidroFundo}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordaLinha}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="22"/>
      </Style>

      <Style x:Key="CartaoItem" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PainelVidroEscuroFundo}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordaLinha}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="14"/>
      </Style>

      <!-- Botão Primário (Ciano Arredondado) -->
      <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AcaoCiano}"/>
        <Setter Property="Foreground" Value="#050D18"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" CornerRadius="4"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Botão Secundário / Vidro Arredondado -->
      <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource PainelVidroEscuroFundo}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordaLinha}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Botão Perigo (Vermelho Arredondado) -->
      <Style x:Key="BotaoPerigo" TargetType="Button">
        <Setter Property="Background" Value="#381515"/>
        <Setter Property="Foreground" Value="#FF4D3D"/>
        <Setter Property="BorderBrush" Value="#662020"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Campo de Texto / TextBox Arredondado -->
      <Style x:Key="CampoTexto" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PainelVidroEscuroFundo}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AcaoCiano}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordaLinha}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="TextBox" BasedOn="{StaticResource CampoTexto}"/>
      <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource PainelVidroEscuroFundo}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordaLinha}"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
      </Style>
      <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource BordaLinha}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AcaoCiano}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource PainelVidroEscuroFundo}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoGelo}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordaLinha}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" Margin="12,6,30,6" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <TextBlock Text="⌄" Foreground="{DynamicResource AcaoCiano}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
              <Border Background="{DynamicResource PainelVidroEscuroFundo}" BorderBrush="{DynamicResource BordaLinha}" BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AcaoCiano}"/>
        <Setter Property="Background" Value="{DynamicResource BordaLinha}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="2"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2"/></Grid>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AcaoCiano}"/><Setter Property="Background" Value="{DynamicResource BordaLinha}"/>
        <Setter Property="MinHeight" Value="34"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
          <Grid Margin="2,0" Background="Transparent">
            <Border Height="5" Background="{TemplateBinding Background}" CornerRadius="3" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="{DynamicResource AcaoCiano}" CornerRadius="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Width="19" Height="24" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid><Ellipse Width="18" Height="18" Fill="{DynamicResource AcaoCiano}" Stroke="{DynamicResource FundoAbismo}" StrokeThickness="3"/><Ellipse Width="4" Height="4" Fill="{DynamicResource TextoGelo}"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource BordaLinha}" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="8"/><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
